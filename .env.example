# Used by docker-compose.yml itself (variable substitution).
# Django's own settings come from backend/.env — keep POSTGRES_* in sync between the two.
POSTGRES_DB=postroom
POSTGRES_USER=postroom
POSTGRES_PASSWORD=change-me
NEXT_PUBLIC_API_BASE=https://api.postroom.in/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...your-site-key

# Used only by docker-compose.prod.yml (GitHub Actions CI/CD deploys) — see DEPLOY.md.
# GHCR_OWNER: your GitHub username/org, lowercase. GHCR_TAG: left as "latest" here;
# the deploy workflow overrides it with the exact commit SHA being deployed.
GHCR_OWNER=your-github-username
GHCR_TAG=latest
