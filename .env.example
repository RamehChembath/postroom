# Used by docker-compose.yml itself (variable substitution).
# Django's own settings come from backend/.env — keep POSTGRES_* in sync between the two.
POSTGRES_DB=postroom
POSTGRES_USER=postroom
POSTGRES_PASSWORD=change-me
NEXT_PUBLIC_API_BASE=https://api.postroom.in/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...your-site-key
