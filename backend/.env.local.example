# Local-only settings — copy this to backend/.env.local and fill in your AI keys.
# Everything else is already set to sensible localhost defaults.

DJANGO_SECRET_KEY=local-dev-only-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:3000

POSTGRES_DB=postroom
POSTGRES_USER=postroom
POSTGRES_PASSWORD=postroom
POSTGRES_HOST=db

# Prints emails (password reset, verification, reminders) to the terminal log
# instead of actually sending them — open a second terminal and run
# `docker compose -f docker-compose.local.yml logs -f backend` to read them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Postroom <noreply@postroom.local>

# Turnstile and Stripe left blank on purpose — both features gracefully no-op
# without keys (registration works with no spam check; billing/checkout just
# won't be testable locally). Fill in only if you specifically want to test them.
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_EXTRA_AVATAR=

# These two you DO need, to see real AI-generated drafts/replies/images instead
# of errors when you click those buttons. Get them from console.anthropic.com
# and platform.openai.com.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
