# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=postroom.in,www.postroom.in,api.postroom.in
CSRF_TRUSTED_ORIGINS=https://postroom.in,https://www.postroom.in
CORS_ALLOWED_ORIGINS=https://postroom.in,https://www.postroom.in
DJANGO_TIME_ZONE=Asia/Kolkata
FRONTEND_URL=https://postroom.in

# ---- Database ----
POSTGRES_DB=postroom
POSTGRES_USER=postroom
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Email (reminders) — Resend, SendGrid SMTP, or any SMTP provider ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Postroom <noreply@postroom.in>

# ---- AI providers ----
ANTHROPIC_API_KEY=sk-ant-change-me
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-change-me
OPENAI_TEXT_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
# "claude" (recommended for writing) or "openai"
TEXT_PROVIDER=claude

# ---- Cloudflare Turnstile (spam protection on signup) ----
# From the Cloudflare dashboard: Turnstile -> Add site. Leave blank to disable
# (registration works without it — fine for local dev, not for production).
TURNSTILE_SECRET_KEY=0x4AAA...your-secret-key

# ---- Auth cookies ----
# Leave blank in local dev. In production, the dot-prefixed parent domain so the
# cookie is sent from the frontend (postroom.in) to the API (api.postroom.in).
COOKIE_DOMAIN=.postroom.in

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_PUBLISHABLE_KEY=pk_live_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
# Three Stripe Prices to create (Products -> Add product, one product per row, INR currency):
#   Base       ₹99/month  recurring  -> STRIPE_PRICE_BASE
#   Pro        ₹199/month recurring  -> STRIPE_PRICE_PRO
#   Extra avatar  ₹100/month recurring, licensed (per-unit quantity) -> STRIPE_PRICE_PRO_EXTRA_AVATAR
#     (this one gets attached as a SECOND line item on a Pro subscription once
#      someone adds a 2nd+ avatar — see billing/stripe_billing.py)
STRIPE_PRICE_BASE=price_change-me
STRIPE_PRICE_PRO=price_change-me
STRIPE_PRICE_PRO_EXTRA_AVATAR=price_change-me
